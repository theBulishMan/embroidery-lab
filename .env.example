OPENAI_BASE_URL=https://baige.walkvre.com:8443/v1
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare

# Optional AI craft advice (manual/rule planning does not need this)
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_PLANNER_MODEL=deepseek-v4.1-flash-1017
# The vision model handles both region recognition and split suggestions.
ALIBABA_VISION_MODEL=deepseek-v4.1-flash-1017
# Use direct here for a machine that can reach DashScope without its system proxy.
ALIBABA_NETWORK_MODE=system
