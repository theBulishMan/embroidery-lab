PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
HOME=/opt/embroidery/shared
XDG_CACHE_HOME=/opt/embroidery/shared/cache
XDG_CONFIG_HOME=/opt/embroidery/shared/config
EMBROIDERY_PUBLIC_ORIGIN=https://design.pikaprint.store
EMBROIDERY_AUTH_REQUIRED=1
EMBROIDERY_AUTH_DB=/opt/embroidery/shared/accounts/accounts.sqlite
EMBROIDERY_DATA_DIR=/opt/embroidery/shared/data
EMBROIDERY_CONFIG_FILE=/opt/embroidery/shared/providers.env
EMBROIDERY_ENGINE_HOME=/opt/embroidery/engine/inkstitch
EMBROIDERY_ENGINE=/opt/embroidery/engine/inkstitch/bin/inkstitch
EMBROIDERY_HEAVY_WORKERS=1
EMBROIDERY_MAX_JOBS=8
EMBROIDERY_JOB_MEMORY_MB=768
EMBROIDERY_ADMISSION_MEMORY_MB=128
EMBROIDERY_MEMORY_RESERVE_MB=64
EMBROIDERY_USE_SWAP_BUFFER=1
EMBROIDERY_QUEUE_TIMEOUT=3600
EMBROIDERY_ENGINE_CPU_PERCENT=100
EMBROIDERY_ENGINE_CPU_SECONDS=900
EMBROIDERY_CPU_TARGET=60
EMBROIDERY_CPU_PAUSE=75
EMBROIDERY_CPU_RESUME=50
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
MALLOC_ARENA_MAX=2
